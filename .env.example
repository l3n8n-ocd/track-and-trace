# Copy to .env.local for local development. Never commit real values.
# See docs/setup-accounts.md for where each value comes from.

DATABASE_URL=mysql://USERNAME:PASSWORD@HOST:4000/returndesk
BETTER_AUTH_SECRET=
APP_URL=http://localhost:3000
# Optional additional static frontend origin for local testing.
# The dedicated Firebase Hosting project is already allowed in production.
CLIENT_APP_URL=http://localhost:5173
CRON_SECRET=

# Optional in development: without these, uploads are stored in public/uploads
# and emails are printed to the server console.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SMTP_USER=
SMTP_PASSWORD=

# First administrator account, created by the seed step.
ADMIN_EMAIL=
ADMIN_PASSWORD=
