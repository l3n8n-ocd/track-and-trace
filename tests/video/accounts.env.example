# Copy this file to tests/video/.env.accounts and fill it in.
# .env.accounts is ignored by Git, so these passwords never leave your PC.

# Test accounts on the live site (verified)
TT_STUDENT_A_EMAIL=
TT_STUDENT_A_PASSWORD=
TT_STUDENT_B_EMAIL=
TT_STUDENT_B_PASSWORD=
TT_STUDENT_C_EMAIL=
TT_STUDENT_C_PASSWORD=
TT_ADMIN_EMAIL=
TT_ADMIN_PASSWORD=

# OBS → Tools → WebSocket Server Settings → Show Connect Info
OBS_WEBSOCKET_PASSWORD=
# OBS_WEBSOCKET_URL=ws://127.0.0.1:4455

# Optional: a different site (default: the live Firebase site)
# VIDEO_BASE_URL=https://track-and-trace-bulsu-2026.web.app
